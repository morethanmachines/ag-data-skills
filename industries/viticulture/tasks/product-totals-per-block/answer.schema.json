{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/morethanmachines/ag-data-skills/main/industries/viticulture/tasks/product-totals-per-block/answer.schema.json",
  "title": "Product totals per block",
  "description": "One entry per wine company block and product.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "wine_company_block",
      "registration_number",
      "product_name",
      "total",
      "unit"
    ],
    "properties": {
      "wine_company_block": {
        "type": "string"
      },
      "registration_number": {
        "type": "string"
      },
      "product_name": {
        "type": "string"
      },
      "total": {
        "type": "number",
        "minimum": 0
      },
      "unit": {
        "enum": [
          "kg",
          "L"
        ]
      }
    },
    "additionalProperties": true
  }
}
