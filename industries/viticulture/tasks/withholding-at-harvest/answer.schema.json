{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/morethanmachines/ag-data-skills/main/industries/viticulture/tasks/withholding-at-harvest/answer.schema.json",
  "title": "Withholding compliance per block",
  "description": "One entry per wine company block with a planned harvest date.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "wine_company_block",
      "harvest_date",
      "compliant",
      "violations"
    ],
    "properties": {
      "wine_company_block": {
        "type": "string"
      },
      "harvest_date": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "compliant": {
        "type": "boolean"
      },
      "violations": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "registration_number",
            "product_name",
            "last_application",
            "withholding_period_days",
            "days_before_harvest"
          ],
          "properties": {
            "registration_number": {
              "type": "string"
            },
            "product_name": {
              "type": "string"
            },
            "last_application": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "withholding_period_days": {
              "type": "integer"
            },
            "days_before_harvest": {
              "type": "integer"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": true
  }
}
